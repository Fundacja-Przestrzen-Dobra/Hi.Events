# Hi.Events deployment — Fundacja Przestrzeń Dobra (Małżeństwo.org)
# Copy to .env and fill in real values. NEVER commit .env.
#   cp .env.example .env
#   echo "APP_KEY=base64:$(openssl rand -base64 32)"   # paste the output below
#   echo "JWT_SECRET=$(openssl rand -base64 32)"       # paste the output below

# --- Application keys (generate once, keep forever) ---
APP_KEY=
JWT_SECRET=

# --- Runtime ---
APP_ENV=production
APP_DEBUG=false
LOG_CHANNEL=stderr
QUEUE_CONNECTION=redis

# --- URLs (must be the address browsers use) ---
# Local:  http://<host-lan-ip>:8810  /  Production: https://zapisy.malzenstwo.org
VITE_FRONTEND_URL=https://zapisy.malzenstwo.org
VITE_API_URL_CLIENT=https://zapisy.malzenstwo.org/api
VITE_API_URL_SERVER=http://localhost:80/api
APP_FRONTEND_URL=https://zapisy.malzenstwo.org
APP_CDN_URL=https://zapisy.malzenstwo.org/storage

# --- Branding / behaviour ---
VITE_APP_NAME=Małżeństwo.org
VITE_COOKIE_CONSENT_ENABLED=false
APP_DISABLE_REGISTRATION=false
APP_SAAS_MODE_ENABLED=false
# Behind one proxy keep `*`; with more hops list every hop, e.g. 127.0.0.1,172.16.0.0/12
APP_TRUSTED_PROXIES=*

# --- E-mail (production: Brevo with SPF + DKIM configured) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_AUTO_TLS=true
MAIL_VERIFY_PEER=true
MAIL_FROM_ADDRESS=powiadomienia@malzenstwo.org
MAIL_FROM_NAME="Małżeństwo.org"

# --- Storage ---
FILESYSTEM_PUBLIC_DISK=public
FILESYSTEM_PRIVATE_DISK=local

# --- Database ---
DB_CONNECTION=pgsql
POSTGRES_DB=hi_events
POSTGRES_USER=hievents
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://hievents:CHANGE_ME@postgres:5432/hi_events

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Payment providers ---
# Stripe: cards and BLIK work in Poland. Its Przelewy24 method is NOT usable by a foundation.
# Leave empty unless Stripe is deliberately enabled for an event.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
# PayU (planned adapter, see malzenstwo.org/docs/04-architektura/payment-providers-adapter.md)
PAYU_POS_ID=
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
PAYU_SECOND_KEY=
PAYU_SANDBOX=true
